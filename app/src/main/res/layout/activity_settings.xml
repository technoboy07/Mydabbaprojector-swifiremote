<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="32dp"
        android:paddingEnd="64dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/port_label"
            android:textColor="@color/text_dim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/port"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/save_port"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="0dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/save_port" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/start_on_boot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="44dp"
            android:text="@string/start_on_boot"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/show_highlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/show_highlight"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/paired_phones"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <Button
            android:id="@+id/revoke_all"
            style="@style/TvButton"
            android:layout_marginTop="16dp"
            android:text="@string/revoke_all" />

        <Button
            android:id="@+id/rotate_code"
            style="@style/TvButton"
            android:text="@string/rotate_code" />
    </LinearLayout>
</ScrollView>
